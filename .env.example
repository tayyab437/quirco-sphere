# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL
VITE_SUPABASE_URL=""
# SUPABASE_ANON_KEY: Your Supabase anonymous key (used on client)
VITE_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY: Your Supabase service role key (used on server to bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=""

# OAUTH_CLIENT_ID_FB: Facebook App ID
VITE_FB_APP_ID=""
# OAUTH_CLIENT_SECRET_FB: Facebook App Secret
FACEBOOK_CLIENT_SECRET=""
# OAUTH_CLIENT_ID_LI: LinkedIn Client ID
VITE_LI_CLIENT_ID=""
# OAUTH_CLIENT_SECRET_LI: LinkedIn Client Secret
LINKEDIN_CLIENT_SECRET=""

# OAUTH_CLIENT_ID_IG: Instagram App ID
VITE_IG_APP_ID=""
# OAUTH_CLIENT_SECRET_IG: Instagram App Secret
INSTAGRAM_CLIENT_SECRET=""
